# Growvia AI - Environment Variables Configuration
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000

# Security (Change in production!)
SECRET_KEY=growvia-ai-secure-secret-key-change-me
JWT_SECRET_KEY=growvia-ai-jwt-secret-key-change-me
JWT_EXPIRATION_HOURS=72

# Database Connection
# SQLite (default for development):
DATABASE_URL=sqlite:///instance/growvia.db
# PostgreSQL (for production):
# DATABASE_URL=postgresql://username:password@localhost:5432/growvia_db

# CORS Configuration
CORS_ORIGINS=*

# Optional External AI Service Credentials (Rule-based recommendation used by default)
OPENAI_API_KEY=
GEMINI_API_KEY=
